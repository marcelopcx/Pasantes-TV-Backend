meta {
  name: Crear categoría
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Deportes"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /categories` — crea una categoría con JSON en el body.
  Responde con la categoría guardada (incluye el `id` generado).
}

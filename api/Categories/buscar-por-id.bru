meta {
  name: Buscar categoría por id
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/categories/id
  body: json
  auth: inherit
}

body:json {
  {
    "id": "1"
  }
}

vars:pre-request {
  baseUrl: https://pasantes-tv-backend-production.up.railway.app
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /categories/id` con body `{ "id": 1 }`.
  Si no existe, el servicio devuelve `null`.
}

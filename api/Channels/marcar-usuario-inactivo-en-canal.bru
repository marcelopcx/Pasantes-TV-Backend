meta {
  name: Marcar usuario inactivo en canal
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/channels/leave
  body: json
  auth: inherit
}

body:json {
  {
    "id": 57,
    "viewerId": "hola"
  }
}

vars:pre-request {
  channelId: 57
  viewerId: user-frontend-001
  baseUrl: localhost:8080
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /channels/leave` — marca al usuario como inactivo en ese canal y lo descuenta del contador sin esperar la ventana de tiempo.
  Body mínimo: `{ "id": <channelId>, "viewerId": "<codigoUnico>" }`.
}

meta {
  name: Crear canal
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/channels
  body: json
  auth: inherit
}

body:json {
  {
    "name":"Cartoon Network",
    "url_m3u8":"https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8",
    "url_image":"https://picsum.photos/800/450"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /channels` — crea un canal con JSON en el body.
  Responde con el canal guardado (incluye el `id` generado).
}

meta {
  name: Marcar usuario activo en canal
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/channels/heartbeat
  body: json
  auth: inherit
}

body:json {
  {
    "id": 57,
    "viewerId": "hola"
  }
}

vars:pre-request {
  channelId: 57
  viewerId: user-frontend-001
  baseUrl: localhost:8080
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /channels/heartbeat` — registra actividad por código único (`viewerId`) en el canal enviado.
  Body mínimo: `{ "id": <channelId>, "viewerId": "<codigoUnico>" }`.
}

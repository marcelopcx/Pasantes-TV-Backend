meta {
  name: Marcar usuario activo en canal
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/channels/heartbeat
  body: json
  auth: inherit
}

body:json {
  {
    "id": {{channelId}}
  }
}

vars:pre-request {
  channelId: 1
  baseUrl: https://pasantes-tv-backend-production.up.railway.app
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /channels/heartbeat` — registra actividad del usuario actual (IP) en el canal enviado.
  Body mínimo: `{ "id": <channelId> }`.
}

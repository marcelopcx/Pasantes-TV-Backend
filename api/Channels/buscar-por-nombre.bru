meta {
  name: Buscar canal por nombre
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/channels/name
  body: json
  auth: inherit
}

body:json {
  {
    "name":"Disney"
  }
}

vars:pre-request {
  baseUrl: https://pasantes-tv-backend-production.up.railway.app
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("devuelve un array", function () {
    expect(res.body).to.be.an("array");
  });
}

docs {
  `POST /channels/name` con body `{ "name": "Cinemax" }`.
}

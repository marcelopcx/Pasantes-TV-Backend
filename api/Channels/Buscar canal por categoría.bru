meta {
  name: Buscar canal por categoría
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/channels/id
  body: json
  auth: inherit
}

body:json {
  {
    "id":"31"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  `POST /channels/id` con body `{ "id": 31 }`.
  Si no existe, el servicio devuelve `null`.
}

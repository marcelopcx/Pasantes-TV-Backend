meta {
  name: Buscar canal por categoría
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/channels/category
  body: json
  auth: inherit
}

body:json {
  {
    "category": "Deportes"
  }
}

vars:pre-request {
  baseUrl: https://pasantes-tv-backend-production.up.railway.app
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("devuelve un array", function () {
    expect(res.body).to.be.an("array");
  });
}

docs {
  `POST /channels/category` con body `{ "category": "Deportes" }`.
}

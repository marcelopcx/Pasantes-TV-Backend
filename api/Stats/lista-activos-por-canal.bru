meta {
  name: Lista activos por canal
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/stats/active-users/by-channel
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: https://pasantes-tv-backend-production.up.railway.app
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body) && res.body.length > 0) {
    const channel = res.body[0];
    if (channel.channelName) {
      bru.setEnvVar("activeChannelName", channel.channelName);
    }
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("devuelve un array", function () {
    expect(res.body).to.be.an("array");
  });
}

docs {
  `GET /stats/active-users/by-channel` — devuelve [{ channelName, activeUsers }].
}
